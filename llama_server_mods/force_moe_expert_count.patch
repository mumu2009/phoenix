diff --git a/src/llama-model.cpp b/src/llama-model.cpp
index 0f4b62c4..82c8ee51 100644
--- a/src/llama-model.cpp
+++ b/src/llama-model.cpp
@@ -9,4 +9,5 @@
 #include <algorithm>
 #include <cassert>
+#include <cstdlib>
 #include <cstring>
 #include <functional>
@@ -432,4 +433,22 @@ void llama_model::load_hparams(llama_model_loader & ml) {
     }
 
+    /* PHOENIX_FORCE_MOE_N_EXPERT_USED
+       LLAMA_FORCE_MOE_EXPERT=N (N >= 0 and N < n_expert) collapses the
+       routed expert count to 1 before tensors and print_info. Weight
+       shapes stay on n_expert. The argsort kernel pins that one top-k
+       slot to expert N. Unset, or a dense model, leaves the GGUF count. */
+    {
+        const char * phx_env = std::getenv("LLAMA_FORCE_MOE_EXPERT");
+        if (phx_env != nullptr && phx_env[0] != '\0' && hparams.n_expert > 0) {
+            const int forced = std::atoi(phx_env);
+            if (forced >= 0 && forced < static_cast<int>(hparams.n_expert)) {
+                const uint32_t native_used = hparams.n_expert_used;
+                hparams.n_expert_used = 1;
+                LLAMA_LOG_INFO("%s: LLAMA_FORCE_MOE_EXPERT=%d n_expert_used=1 (native %u)\n",
+                               __func__, forced, native_used);
+            }
+        }
+    }
+
     // zero-out the array hparams
     std::fill(hparams.n_head_arr.begin(),    hparams.n_head_arr.end(),    0);
diff --git a/src/llama.cpp b/src/llama.cpp
