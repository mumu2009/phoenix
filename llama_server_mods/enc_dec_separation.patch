+    //
+    // Phoenix enc / infer / dec split
+    //
+    // Conceptually splits what llama_decode() normally does in one fused pass
+    // into three independently callable stages:
+    //   enc   : input tokens         -> hidden states (embedding lookup)
+    //   infer : hidden states        -> hidden states (full transformer body,
+    //           attention + FFN stack, still uses/updates the KV cache)
+    //   dec   : hidden states        -> logits        (final norm + lm_head)
+    //
+    // These are convenience wrappers around the existing llama_decode()
+    // machinery (they temporarily flip llama_context::cparams.embeddings /
+    // pooling_type and a per-context stage selector), so KV-cache semantics,
+    // batching, and threading behave exactly as they do for a normal
+    // llama_decode() call. "full" (fused) behavior is unaffected unless one
+    // of these is called.
+    //
+
+    enum llama_phx_stage {
+        LLAMA_PHX_STAGE_FULL  = 0, // normal fused llama_decode() behavior (default)
+        LLAMA_PHX_STAGE_ENC   = 1, // tokens -> hidden states
+        LLAMA_PHX_STAGE_INFER = 2, // hidden states -> hidden states
