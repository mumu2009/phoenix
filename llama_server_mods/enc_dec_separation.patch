+void llama_phx_set_stage(struct llama_context * ctx, enum llama_phx_stage stage) {
+    if (!ctx) {
+        return;
+    }
+    ctx->phx_split.stage = stage;
+}
+
+enum llama_phx_stage llama_phx_get_stage(struct llama_context * ctx) {
+    if (!ctx) {
+        return LLAMA_PHX_STAGE_FULL;
+    }
+    return ctx->phx_split.stage;
+}
+
+// Shared helper: run one phx stage through the normal llama_decode() path,
+// temporarily overriding cparams.embeddings/pooling_type as needed so that
+// the existing output-extraction code in llama_decode_impl() (llama.cpp)
+// routes the stage's result into either lctx.embd (hidden-state stages) or
+// lctx.logits (the dec stage), then restores the previous settings.
+static int32_t llama_phx_run_stage(
+        struct llama_context * ctx,
+        enum llama_phx_stage    stage,
+        const llama_token     * tokens,     // used for ENC only
+        const float           * in_hidden,  // used for INFER / DEC
+        int32_t                 n_tokens,
+        const llama_pos       * positions,  // may be NULL, used for INFER only
+        float                 * out_buf) {
+    if (!ctx || n_tokens <= 0 || out_buf == nullptr) {
+        return -1;
+    }
+    if (stage == LLAMA_PHX_STAGE_ENC && tokens == nullptr) {
+        return -1;
+    }
+    if ((stage == LLAMA_PHX_STAGE_INFER || stage == LLAMA_PHX_STAGE_DEC) && in_hidden == nullptr) {
+        return -1;
+    }
+
+    const int32_t n_embd = llama_model_n_embd(&ctx->model);
+
+    const bool                saved_embeddings   = ctx->cparams.embeddings;
+    const enum llama_pooling_type saved_pooling  = ctx->cparams.pooling_type;
+    const enum llama_phx_stage saved_stage        = ctx->phx_split.stage;
+
+    const bool needs_hidden_output = (stage == LLAMA_PHX_STAGE_ENC || stage == LLAMA_PHX_STAGE_INFER);
+    if (needs_hidden_output) {
+        // route through the existing "token embeddings" (pooling==NONE)
+        // extraction path in llama_decode_impl(), which already copies
+        // per-token float vectors into lctx.embd.
+        ctx->cparams.embeddings   = true;
+        ctx->cparams.pooling_type = LLAMA_POOLING_TYPE_NONE;
+    } else {
+        // dec: reuse the normal logits path unchanged.
+        ctx->cparams.embeddings = false;
+    }
+
+    ctx->phx_split.stage = stage;
+
+    const int32_t n_embd_batch = (stage == LLAMA_PHX_STAGE_ENC) ? 0 : n_embd;
+    struct llama_batch batch = llama_batch_init(n_tokens, n_embd_batch, 1);
+    batch.n_tokens = n_tokens;
+
+    for (int32_t i = 0; i < n_tokens; ++i) {
+        if (stage == LLAMA_PHX_STAGE_ENC) {
+            batch.token[i] = tokens[i];
+        } else {
+            std::memcpy(batch.embd + (size_t) i * n_embd, in_hidden + (size_t) i * n_embd, n_embd * sizeof(float));
+        }
+        batch.pos[i]      = positions ? positions[i] : i;
+        batch.n_seq_id[i] = 1;
+        batch.seq_id[i][0] = 0;
+        batch.logits[i]   = 1; // we need output for every token, not just the last
+    }
+
+    const int32_t ret = llama_decode(ctx, batch);
+
+    if (ret == 0) {
+        if (needs_hidden_output) {
+            const float * embd = llama_get_embeddings(ctx);
+            if (embd != nullptr) {
+                std::memcpy(out_buf, embd, (size_t) n_tokens * n_embd * sizeof(float));
+            }
+        } else {
+            const float * logits = llama_get_logits(ctx);
+            if (logits != nullptr) {
+                const int32_t n_vocab = llama_vocab_n_tokens(llama_model_get_vocab(&ctx->model));
+                std::memcpy(out_buf, logits, (size_t) n_tokens * n_vocab * sizeof(float));
+            }
+        }
+    }
+
+    llama_batch_free(batch);
+
+    ctx->cparams.embeddings   = saved_embeddings;
+    ctx->cparams.pooling_type = saved_pooling;
+    ctx->phx_split.stage      = saved_stage;
+
+    return ret;
+}
+
+int32_t llama_phx_encode(
+        struct llama_context * ctx,
+          const llama_token *  tokens,
+                    int32_t    n_tokens,
+                      float *  out_hidden) {
+    return llama_phx_run_stage(ctx, LLAMA_PHX_STAGE_ENC, tokens, nullptr, n_tokens, nullptr, out_hidden);
+}
+
+int32_t llama_phx_infer(
+        struct llama_context * ctx,
+                  const float * in_hidden,
+                      int32_t   n_tokens,
+              const llama_pos * positions,
+                        float * out_hidden) {
+    return llama_phx_run_stage(ctx, LLAMA_PHX_STAGE_INFER, nullptr, in_hidden, n_tokens, positions, out_hidden);
+}
+
+int32_t llama_phx_decode(
+        struct llama_context * ctx,
+                  const float * in_hidden,
+                      int32_t   n_tokens,
+                        float * out_logits) {
+    return llama_phx_run_stage(ctx, LLAMA_PHX_STAGE_DEC, nullptr, in_hidden, n_tokens, nullptr, out_logits);
+}
