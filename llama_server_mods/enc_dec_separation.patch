+
+    // ------------------------------------------------------------------
+    // /phx/generate: server-side token-in-token-out generation.
+    //
+    // Encapsulates the autoregressive loop (dec -> sample -> enc -> infer)
+    // so that the client only sees:
+    //   enc(prompt) -> /phx/generate (inference) -> modality-specific dec
+    // The endpoint accepts prompt as content/tokens/hidden and returns the
+    // generated token ids and (optionally) the per-step unit queries and
+    // a detokenized text string.
+    // ------------------------------------------------------------------
+
+    const auto handle_phx_generate = [&ctx_server, &res_error, &res_ok](const httplib::Request & req, httplib::Response & res) {
+        const json body = json::parse(req.body);
+
+        const int32_t n_embd = llama_model_n_embd(ctx_server.model);
+        const int32_t n_vocab = llama_vocab_n_tokens(ctx_server.vocab);
+        const int32_t n_ctx  = llama_n_ctx(ctx_server.ctx);
+
+        const int32_t max_tokens = json_value(body, "max_tokens", 16);
+        if (max_tokens < 1) {
+            res_error(res, format_error_response("\"max_tokens\" must be >= 1", ERROR_TYPE_INVALID_REQUEST));
+            return;
+        }
+        if (max_tokens > n_ctx) {
+            res_error(res, format_error_response("\"max_tokens\" exceeds context size", ERROR_TYPE_INVALID_REQUEST));
+            return;
+        }
+
+        const float temperature = json_value(body, "temperature", 0.8f);
+        const float top_p       = json_value(body, "top_p", 0.95f);
+        const uint32_t seed     = json_value(body, "seed", (uint32_t) 0);
+        const bool return_hidden = json_value(body, "return_hidden", true);
+        const bool decode_text   = json_value(body, "decode_text", true);
+
+        std::vector<llama_token> stop_token_ids;
+        if (body.contains("stop_token_ids") && body.at("stop_token_ids").is_array()) {
+            stop_token_ids = body.at("stop_token_ids").get<std::vector<llama_token>>();
+        }
+        const llama_token eos = llama_vocab_eos(ctx_server.vocab);
+        if (eos >= 0) {
+            stop_token_ids.push_back(eos);
+        }
+
+        // --- encode prompt into hidden states ---
+        int32_t n_prompt_tokens = 0;
+        std::vector<float> prompt_hidden;
+
+        if (body.contains("hidden")) {
+            const json & rows = body.at("hidden");
+            n_prompt_tokens = (int32_t) rows.size();
+            if (n_prompt_tokens == 0) {
+                res_error(res, format_error_response("\"hidden\" must not be empty", ERROR_TYPE_INVALID_REQUEST));
+                return;
+            }
+            prompt_hidden.resize((size_t) n_prompt_tokens * n_embd);
+            for (int32_t i = 0; i < n_prompt_tokens; i++) {
+                const std::vector<float> row = rows[i].get<std::vector<float>>();
+                if ((int32_t) row.size() != n_embd) {
+                    res_error(res, format_error_response("each \"hidden\" row must have n_embd floats", ERROR_TYPE_INVALID_REQUEST));
+                    return;
+                }
+                std::copy(row.begin(), row.end(), prompt_hidden.begin() + (size_t) i * n_embd);
+            }
+        } else if (body.contains("tokens")) {
+            const llama_tokens tokens = body.at("tokens").get<llama_tokens>();
+            n_prompt_tokens = (int32_t) tokens.size();
+            if (n_prompt_tokens == 0) {
+                res_error(res, format_error_response("\"tokens\" must not be empty", ERROR_TYPE_INVALID_REQUEST));
+                return;
+            }
+            prompt_hidden.resize((size_t) n_prompt_tokens * n_embd);
+            int32_t ret;
+            {
+                std::lock_guard<std::mutex> lock(ctx_server.phx_mutex);
+                ret = llama_phx_encode(ctx_server.ctx, tokens.data(), n_prompt_tokens, prompt_hidden.data());
+            }
+            if (ret != 0) {
+                res_error(res, format_error_response("llama_phx_encode failed", ERROR_TYPE_SERVER));
+                return;
+            }
+        } else if (body.contains("content")) {
+            const bool add_special = json_value(body, "add_special", true);
+            const llama_tokens tokens = tokenize_mixed(ctx_server.vocab, body.at("content"), add_special, true);
+            n_prompt_tokens = (int32_t) tokens.size();
+            if (n_prompt_tokens == 0) {
+                res_error(res, format_error_response("no tokens to encode", ERROR_TYPE_INVALID_REQUEST));
+                return;
+            }
+            prompt_hidden.resize((size_t) n_prompt_tokens * n_embd);
+            int32_t ret;
+            {
+                std::lock_guard<std::mutex> lock(ctx_server.phx_mutex);
+                ret = llama_phx_encode(ctx_server.ctx, tokens.data(), n_prompt_tokens, prompt_hidden.data());
+            }
+            if (ret != 0) {
+                res_error(res, format_error_response("llama_phx_encode failed", ERROR_TYPE_SERVER));
+                return;
+            }
+        } else {
+            res_error(res, format_error_response("\"hidden\", \"tokens\" or \"content\" must be provided", ERROR_TYPE_INVALID_REQUEST));
+            return;
+        }
+
+        // --- prime KV cache with prompt ---
+        std::vector<llama_pos> prompt_positions(n_prompt_tokens);
+        for (int32_t i = 0; i < n_prompt_tokens; i++) {
+            prompt_positions[i] = i;
+        }
+
+        std::vector<float> prompt_out((size_t) n_prompt_tokens * n_embd);
+        int32_t ret;
+        {
+            std::lock_guard<std::mutex> lock(ctx_server.phx_mutex);
+            ret = llama_phx_infer(ctx_server.ctx, prompt_hidden.data(), n_prompt_tokens, prompt_positions.data(), prompt_out.data());
+        }
+        if (ret != 0) {
+            res_error(res, format_error_response("llama_phx_infer (prompt) failed", ERROR_TYPE_SERVER));
+            return;
+        }
+
+        // --- sampling setup ---
+        std::mt19937 rng(seed != 0 ? (unsigned) seed : std::random_device{}());
+
+        auto sample_logit = [&rng](const float * logits, int32_t n_vocab, float temp, float p_top) -> llama_token {
+            if (n_vocab <= 0) return -1;
+
+            // Greedy (temperature == 0) -> argmax over the raw logits.
+            if (temp <= 1e-6f) {
+                llama_token best = 0;
+                for (int32_t i = 1; i < n_vocab; ++i) {
+                    if (logits[i] > logits[best]) best = i;
+                }
+                return best;
+            }
+
+            // Apply temperature and softmax.
+            float max_logit = *std::max_element(logits, logits + n_vocab);
+            std::vector<std::pair<double, llama_token>> probs;
+            probs.reserve(n_vocab);
+            double sum = 0.0;
+            for (llama_token i = 0; i < n_vocab; ++i) {
+                double p = std::exp(((double) logits[i] - (double) max_logit) / (double) temp);
+                if (!std::isfinite(p)) p = 0.0;
+                sum += p;
+                probs.emplace_back(p, i);
+            }
+            if (sum <= 0.0 || !std::isfinite(sum)) {
+                llama_token best = 0;
+                for (int32_t i = 1; i < n_vocab; ++i) {
+                    if (logits[i] > logits[best]) best = i;
+                }
+                return best;
+            }
+            for (auto & pr : probs) pr.first /= sum;
+
+            // Top-p (nucleus) filtering.
+            float clamped_top_p = std::clamp(p_top, 0.0f, 1.0f);
+            if (clamped_top_p <= 0.0f) clamped_top_p = 1.0f;
+            std::sort(probs.begin(), probs.end(),
+                      [](const auto & a, const auto & b) { return a.first > b.first; });
+            double cum = 0.0;
+            size_t keep = probs.size();
+            for (size_t i = 0; i < probs.size(); ++i) {
+                cum += probs[i].first;
+                if (cum >= clamped_top_p) {
+                    keep = i + 1;
+                    break;
+                }
+            }
+            probs.resize(keep);
+
+            // Renormalize and sample.
+            double psum = 0.0;
+            for (const auto & pr : probs) psum += pr.first;
+            if (psum > 0.0) {
+                for (auto & pr : probs) pr.first /= psum;
+            }
+            std::uniform_real_distribution<double> dist(0.0, 1.0);
+            double r = dist(rng);
+            cum = 0.0;
+            for (const auto & pr : probs) {
+                cum += pr.first;
+                if (r <= cum) return pr.second;
+            }
+            return probs.back().second;
+        };
+
+        std::vector<llama_token> generated_tokens;
+        std::vector<std::vector<float>> generated_hidden;
+        generated_tokens.reserve(max_tokens);
+        if (return_hidden) {
+            generated_hidden.reserve(max_tokens);
+        }
+
+        std::vector<float> last_hidden(n_embd);
+        std::copy(prompt_out.begin() + (size_t)(n_prompt_tokens - 1) * n_embd,
+                  prompt_out.begin() + (size_t) n_prompt_tokens * n_embd,
+                  last_hidden.begin());
+
+        std::vector<float> logits((size_t) n_vocab);
+        std::vector<float> embd(n_embd);
+        std::vector<float> infer_out(n_embd);
+        std::vector<llama_pos> gen_pos(1);
+
+        {
+            std::lock_guard<std::mutex> lock(ctx_server.phx_mutex);
+            for (int32_t step = 0; step < max_tokens; ++step) {
+                // dec: unit query -> logits (logits buffer is in vocab order)
+                int32_t dec_ret = llama_phx_decode(ctx_server.ctx, last_hidden.data(), 1, logits.data());
+                if (dec_ret != 0) {
+                    res_error(res, format_error_response("llama_phx_decode failed", ERROR_TYPE_SERVER));
+                    return;
+                }
+
+                // sample next token from the logits buffer directly
+                const llama_token tok = sample_logit(logits.data(), n_vocab, temperature, top_p);
+
+                if (std::find(stop_token_ids.begin(), stop_token_ids.end(), tok) != stop_token_ids.end()) {
+                    break;
+                }
+
+                generated_tokens.push_back(tok);
+                if (return_hidden) {
+                    generated_hidden.push_back(last_hidden);
+                }
+
+                // enc: token -> embedding (unit query for next infer step)
+                int32_t enc_ret = llama_phx_encode(ctx_server.ctx, &tok, 1, embd.data());
+                if (enc_ret != 0) {
+                    res_error(res, format_error_response("llama_phx_encode failed", ERROR_TYPE_SERVER));
+                    return;
+                }
+
+                // infer: unit query -> unit query
+                gen_pos[0] = n_prompt_tokens + step;
+                int32_t infer_ret = llama_phx_infer(ctx_server.ctx, embd.data(), 1, gen_pos.data(), infer_out.data());
+                if (infer_ret != 0) {
+                    res_error(res, format_error_response("llama_phx_infer failed", ERROR_TYPE_SERVER));
+                    return;
+                }
+
+                std::copy(infer_out.begin(), infer_out.begin() + n_embd, last_hidden.begin());
+            }
+        }
+
+        json data = json{
+            {"n_tokens", (int) generated_tokens.size()},
+            {"tokens",   generated_tokens},
+        };
+
+        if (decode_text) {
+            std::string text;
+            for (llama_token tok : generated_tokens) {
+                text += common_token_to_piece(ctx_server.ctx, tok);
+            }
+            data["text"] = text;
+        }
+
+        if (return_hidden) {
+            json hidden_json = json::array();
+            for (const auto & h : generated_hidden) {
+                hidden_json.push_back(h);
+            }
+            data["hidden"] = hidden_json;
+        }
+
+        res_ok(res, data);
+    };
