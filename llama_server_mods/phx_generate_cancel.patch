# Live llama is NOT rebuilt by the gateway fix; this is for the next llama build.
--- a/examples/server/server.cpp
+++ b/examples/server/server.cpp
@@ -1813,6 +1813,7 @@ struct server_context {
     // production traffic; run the server with a single concurrent client
