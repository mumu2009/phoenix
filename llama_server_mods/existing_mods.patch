+void llama_style_adapter_enable(struct llama_context * ctx, bool enabled) {
+    if (!ctx) {
+        return;
+    }
+    ctx->style_adapter.enabled = enabled;
+}
+
+void llama_style_adapter_set_target(struct llama_context * ctx, float target_align) {
+    if (!ctx) {
+        return;
+    }
+    if (!std::isfinite(target_align)) {
+        return;
+    }
+    ctx->style_adapter.target_align = std::clamp(target_align, 0.0f, 1.0f);
+}
+
+void llama_style_adapter_configure(struct llama_context * ctx, float lr, float clip_abs) {
+    if (!ctx) {
+        return;
+    }
+    if (std::isfinite(lr) && lr > 0.0f) {
+        ctx->style_adapter.lr = lr;
+    }
+    if (std::isfinite(clip_abs) && clip_abs > 0.0f) {
+        ctx->style_adapter.clip_abs = clip_abs;
+    }
+}
+
+float llama_style_adapter_train_step(struct llama_context * ctx, float observed_align, float loss_scale, float keyword_density, float sentiment, float punctuation_density, float graph_edge_weight, float graph_residual) {
+    if (!ctx) {
+        return 0.0f;
+    }
+    if (!std::isfinite(observed_align)) {
+        observed_align = 0.0f;
+    }
+    if (!std::isfinite(loss_scale) || loss_scale <= 0.0f) {
+        loss_scale = 1.0f;
+    }
+    if (!std::isfinite(keyword_density)) {
+        keyword_density = 0.0f;
+    }
+    if (!std::isfinite(sentiment)) {
+        sentiment = 0.0f;
+    }
+    if (!std::isfinite(punctuation_density)) {
+        punctuation_density = 0.0f;
+    }
+    if (!std::isfinite(graph_edge_weight)) {
+        graph_edge_weight = 0.0f;
+    }
+    if (!std::isfinite(graph_residual)) {
+        graph_residual = 0.0f;
+    }
+
+    keyword_density = std::clamp(keyword_density, 0.0f, 1.0f);
+    sentiment = std::clamp(sentiment, -1.0f, 1.0f);
+    punctuation_density = std::clamp(punctuation_density, 0.0f, 1.0f);
+    graph_edge_weight = std::clamp(graph_edge_weight, 0.0f, 1.0f);
+    graph_residual = std::clamp(graph_residual, 0.0f, 1.0f);
+
+    ctx->style_adapter.feature_keyword_density = keyword_density;
+    ctx->style_adapter.feature_sentiment = sentiment;
+    ctx->style_adapter.feature_punctuation_density = punctuation_density;
+    ctx->style_adapter.graph_edge_weight = graph_edge_weight;
+    ctx->style_adapter.graph_residual = graph_residual;
+
+    const float clipped_observed = std::clamp(observed_align, 0.0f, 1.0f);
+    const float err = ctx->style_adapter.target_align - clipped_observed;
+    const float grad = err * loss_scale;
+    const float next_bias = ctx->style_adapter.bias + ctx->style_adapter.lr * grad;
+    const float lim = std::max(0.001f, ctx->style_adapter.clip_abs);
+    ctx->style_adapter.bias = std::clamp(next_bias, -lim, lim);
+
+    const float feature_lr = ctx->style_adapter.lr * 0.25f;
+    const float next_keyword_gain = ctx->style_adapter.feature_keyword_gain + feature_lr * grad * keyword_density;
+    const float next_sentiment_gain = ctx->style_adapter.feature_sentiment_gain + feature_lr * grad * sentiment;
+    const float next_punctuation_gain = ctx->style_adapter.feature_punctuation_gain + feature_lr * grad * punctuation_density;
+    const float next_graph_edge_gain = ctx->style_adapter.graph_edge_gain + feature_lr * grad * graph_edge_weight;
+    const float next_graph_residual_gain = ctx->style_adapter.graph_residual_gain - feature_lr * grad * graph_residual;
+    ctx->style_adapter.feature_keyword_gain = std::clamp(next_keyword_gain, -lim, lim);
+    ctx->style_adapter.feature_sentiment_gain = std::clamp(next_sentiment_gain, -lim, lim);
+    ctx->style_adapter.feature_punctuation_gain = std::clamp(next_punctuation_gain, -lim, lim);
+    ctx->style_adapter.graph_edge_gain = std::clamp(next_graph_edge_gain, -lim, lim);
+    ctx->style_adapter.graph_residual_gain = std::clamp(next_graph_residual_gain, -lim, lim);
+
+    ctx->style_adapter.steps += 1;
+    return llama_style_adapter_effective_bias(*ctx);
+}
+
+float llama_style_adapter_get_bias(struct llama_context * ctx) {
+    if (!ctx) {
+        return 0.0f;
+    }
+    return llama_style_adapter_effective_bias(*ctx);
+}
+
 void llama_synchronize(struct llama_context * ctx) {
     ggml_backend_sched_synchronize(ctx->sched.get());
 
