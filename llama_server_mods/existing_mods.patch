+static inline float llama_style_adapter_effective_bias(const struct llama_context & lctx) {
+    const auto & st = lctx.style_adapter;
+    const float lim = std::max(0.001f, st.clip_abs);
+    const float composed = st.bias
+        + st.feature_keyword_gain * st.feature_keyword_density
+        + st.feature_sentiment_gain * st.feature_sentiment
+        + st.feature_punctuation_gain * st.feature_punctuation_density
+        + st.graph_edge_gain * st.graph_edge_weight
+        + st.graph_residual_gain * st.graph_residual;
+    return std::clamp(composed, -lim, lim);
+}
