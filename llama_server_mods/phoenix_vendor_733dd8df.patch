+    // ------------------------------------------------------------------
+    // Phoenix enc / infer / dec split endpoints.
+    //
+    // These expose the llama_phx_encode()/llama_phx_infer()/llama_phx_decode()
+    // C API (see include/llama.h) added for splitting llama3.1-8b into three
+    // conceptual pieces:
+    //   POST /phx/enc   tokens         -> hidden states
+    //   POST /phx/infer hidden states  -> hidden states (full transformer body)
+    //   POST /phx/dec   hidden states  -> logits
+    //
+    // Intentionally implemented as direct synchronous calls into ctx_server.ctx
+    // (protected by ctx_server.phx_mutex) rather than through the slot/task
+    // queue, since these are meant for offline pipeline experimentation
+    // (e.g. running enc/infer/dec on different machines or processes) rather
+    // than high-throughput concurrent serving. Do not mix heavy concurrent
+    // /completion traffic with these endpoints.
+    // ------------------------------------------------------------------
+
+    const auto handle_phx_enc = [&ctx_server, &res_error, &res_ok](const httplib::Request & req, httplib::Response & res) {
+        const json body = json::parse(req.body);
+
+        llama_tokens tokens;
+        if (body.contains("tokens")) {
+            tokens = body.at("tokens").get<llama_tokens>();
+        } else if (body.contains("content")) {
+            const bool add_special = json_value(body, "add_special", true);
+            tokens = tokenize_mixed(ctx_server.vocab, body.at("content"), add_special, true);
+        } else {
+            res_error(res, format_error_response("\"tokens\" or \"content\" must be provided", ERROR_TYPE_INVALID_REQUEST));
+            return;
+        }
+
+        if (tokens.empty()) {
+            res_error(res, format_error_response("no tokens to encode", ERROR_TYPE_INVALID_REQUEST));
+            return;
+        }
+
+        const int32_t n_embd = llama_model_n_embd(ctx_server.model);
+        std::vector<float> hidden((size_t) tokens.size() * n_embd);
+
+        int32_t ret;
+        {
+            std::lock_guard<std::mutex> lock(ctx_server.phx_mutex);
+            ret = llama_phx_encode(ctx_server.ctx, tokens.data(), (int32_t) tokens.size(), hidden.data());
+        }
+
+        if (ret != 0) {
+            res_error(res, format_error_response("llama_phx_encode failed", ERROR_TYPE_SERVER));
+            return;
+        }
+
+        json hidden_json = json::array();
+        for (size_t i = 0; i < tokens.size(); i++) {
+            hidden_json.push_back(std::vector<float>(hidden.begin() + i * n_embd, hidden.begin() + (i + 1) * n_embd));
+        }
+
+        res_ok(res, json{
+            {"n_tokens", tokens.size()},
+            {"n_embd",   n_embd},
+            {"tokens",   tokens},
+            {"hidden",   hidden_json},
+        });
+    };
+
+    const auto handle_phx_infer = [&ctx_server, &res_error, &res_ok](const httplib::Request & req, httplib::Response & res) {
+        const json body = json::parse(req.body);
+
+        if (!body.contains("hidden") || !body.at("hidden").is_array() || body.at("hidden").empty()) {
+            res_error(res, format_error_response("\"hidden\" (array of n_embd-length float rows) must be provided", ERROR_TYPE_INVALID_REQUEST));
+            return;
+        }
+
+        const int32_t n_embd   = llama_model_n_embd(ctx_server.model);
+        const json  & rows     = body.at("hidden");
+        const int32_t n_tokens = (int32_t) rows.size();
+
+        std::vector<float> hidden_in((size_t) n_tokens * n_embd);
+        for (int32_t i = 0; i < n_tokens; i++) {
+            const std::vector<float> row = rows[i].get<std::vector<float>>();
+            if ((int32_t) row.size() != n_embd) {
+                res_error(res, format_error_response("each \"hidden\" row must have n_embd floats", ERROR_TYPE_INVALID_REQUEST));
+                return;
+            }
+            std::copy(row.begin(), row.end(), hidden_in.begin() + (size_t) i * n_embd);
+        }
+
+        std::vector<llama_pos> positions;
+        const llama_pos * positions_ptr = nullptr;
+        if (body.contains("positions")) {
+            positions = body.at("positions").get<std::vector<llama_pos>>();
+            if ((int32_t) positions.size() != n_tokens) {
+                res_error(res, format_error_response("\"positions\" must have the same length as \"hidden\"", ERROR_TYPE_INVALID_REQUEST));
+                return;
+            }
+            positions_ptr = positions.data();
+        }
+
+        std::vector<float> hidden_out((size_t) n_tokens * n_embd);
+
+        int32_t ret;
+        {
+            std::lock_guard<std::mutex> lock(ctx_server.phx_mutex);
+            ret = llama_phx_infer(ctx_server.ctx, hidden_in.data(), n_tokens, positions_ptr, hidden_out.data());
+        }
+
+        if (ret != 0) {
+            res_error(res, format_error_response("llama_phx_infer failed", ERROR_TYPE_SERVER));
+            return;
+        }
+
+        json hidden_json = json::array();
+        for (int32_t i = 0; i < n_tokens; i++) {
+            hidden_json.push_back(std::vector<float>(hidden_out.begin() + i * n_embd, hidden_out.begin() + (i + 1) * n_embd));
+        }
+
+        res_ok(res, json{
+            {"n_tokens", n_tokens},
+            {"n_embd",   n_embd},
+            {"hidden",   hidden_json},
+        });
+    };
+
+    const auto handle_phx_dec = [&ctx_server, &res_error, &res_ok](const httplib::Request & req, httplib::Response & res) {
+        const json body = json::parse(req.body);
+
+        if (!body.contains("hidden") || !body.at("hidden").is_array() || body.at("hidden").empty()) {
+            res_error(res, format_error_response("\"hidden\" (array of n_embd-length float rows) must be provided", ERROR_TYPE_INVALID_REQUEST));
+            return;
+        }
+
+        const int32_t n_embd   = llama_model_n_embd(ctx_server.model);
+        const int32_t n_vocab  = llama_vocab_n_tokens(ctx_server.vocab);
+        const json  & rows     = body.at("hidden");
+        const int32_t n_tokens = (int32_t) rows.size();
+
+        std::vector<float> hidden_in((size_t) n_tokens * n_embd);
+        for (int32_t i = 0; i < n_tokens; i++) {
+            const std::vector<float> row = rows[i].get<std::vector<float>>();
+            if ((int32_t) row.size() != n_embd) {
+                res_error(res, format_error_response("each \"hidden\" row must have n_embd floats", ERROR_TYPE_INVALID_REQUEST));
+                return;
+            }
+            std::copy(row.begin(), row.end(), hidden_in.begin() + (size_t) i * n_embd);
+        }
+
+        const bool with_logits = json_value(body, "with_logits", false);
+
+        std::vector<float> logits((size_t) n_tokens * n_vocab);
+
+        int32_t ret;
+        {
+            std::lock_guard<std::mutex> lock(ctx_server.phx_mutex);
+            ret = llama_phx_decode(ctx_server.ctx, hidden_in.data(), n_tokens, logits.data());
+        }
+
+        if (ret != 0) {
+            res_error(res, format_error_response("llama_phx_decode failed", ERROR_TYPE_SERVER));
+            return;
+        }
+
+        json tokens_json = json::array();
+        for (int32_t i = 0; i < n_tokens; i++) {
+            const float * row = logits.data() + (size_t) i * n_vocab;
+            int32_t best = 0;
+            for (int32_t v = 1; v < n_vocab; v++) {
+                if (row[v] > row[best]) {
+                    best = v;
+                }
+            }
+            tokens_json.push_back({
+                {"token", best},
+                {"piece", common_token_to_piece(ctx_server.ctx, best)},
+            });
+        }
+
+        json data{
+            {"n_tokens", n_tokens},
+            {"n_vocab",  n_vocab},
+            {"tokens",   tokens_json},
+        };
+
+        if (with_logits) {
+            json logits_json = json::array();
+            for (int32_t i = 0; i < n_tokens; i++) {
+                logits_json.push_back(std::vector<float>(logits.begin() + i * n_vocab, logits.begin() + (i + 1) * n_vocab));
+            }
+            data["logits"] = logits_json;
+        }
+
+        res_ok(res, data);
+    };
+
+    // ------------------------------------------------------------------
+    // /phx/generate: server-side token-in-token-out generation.
+    //
+    // Encapsulates the autoregressive loop (dec -> sample -> enc -> infer)
+    // so that the client only sees:
+    //   enc(prompt) -> /phx/generate (inference) -> modality-specific dec
+    // The endpoint accepts prompt as content/tokens/hidden and returns the
+    // generated token ids and (optionally) the per-step unit queries and
+    // a detokenized text string.
+    // ------------------------------------------------------------------
+
+    const auto handle_phx_generate = [&ctx_server, &res_error, &res_ok](const httplib::Request & req, httplib::Response & res) {
+        const json body = json::parse(req.body);
+
+        const int32_t n_embd = llama_model_n_embd(ctx_server.model);
+        const int32_t n_vocab = llama_vocab_n_tokens(ctx_server.vocab);
+        const int32_t n_ctx  = llama_n_ctx(ctx_server.ctx);
+
+        const int32_t max_tokens = json_value(body, "max_tokens", 16);
+        if (max_tokens < 1) {
+            res_error(res, format_error_response("\"max_tokens\" must be >= 1", ERROR_TYPE_INVALID_REQUEST));
+            return;
+        }
+        if (max_tokens > n_ctx) {
+            res_error(res, format_error_response("\"max_tokens\" exceeds context size", ERROR_TYPE_INVALID_REQUEST));
+            return;
+        }
+
+        const float temperature = json_value(body, "temperature", 0.8f);
+        const float top_p       = json_value(body, "top_p", 0.95f);
+        const uint32_t seed     = json_value(body, "seed", (uint32_t) 0);
+        const bool return_hidden = json_value(body, "return_hidden", true);
+        const bool decode_text   = json_value(body, "decode_text", true);
+
+        std::vector<llama_token> stop_token_ids;
+        if (body.contains("stop_token_ids") && body.at("stop_token_ids").is_array()) {
+            stop_token_ids = body.at("stop_token_ids").get<std::vector<llama_token>>();
+        }
+        const llama_token eos = llama_vocab_eos(ctx_server.vocab);
+        if (eos >= 0) {
+            stop_token_ids.push_back(eos);
+        }
+
+        // --- encode prompt into hidden states ---
+        int32_t n_prompt_tokens = 0;
+        std::vector<float> prompt_hidden;
+
+        if (body.contains("hidden")) {
+            const json & rows = body.at("hidden");
+            n_prompt_tokens = (int32_t) rows.size();
+            if (n_prompt_tokens == 0) {
+                res_error(res, format_error_response("\"hidden\" must not be empty", ERROR_TYPE_INVALID_REQUEST));
+                return;
+            }
+            prompt_hidden.resize((size_t) n_prompt_tokens * n_embd);
+            for (int32_t i = 0; i < n_prompt_tokens; i++) {
+                const std::vector<float> row = rows[i].get<std::vector<float>>();
+                if ((int32_t) row.size() != n_embd) {
+                    res_error(res, format_error_response("each \"hidden\" row must have n_embd floats", ERROR_TYPE_INVALID_REQUEST));
+                    return;
+                }
+                std::copy(row.begin(), row.end(), prompt_hidden.begin() + (size_t) i * n_embd);
+            }
+        } else if (body.contains("tokens")) {
+            const llama_tokens tokens = body.at("tokens").get<llama_tokens>();
+            n_prompt_tokens = (int32_t) tokens.size();
+            if (n_prompt_tokens == 0) {
+                res_error(res, format_error_response("\"tokens\" must not be empty", ERROR_TYPE_INVALID_REQUEST));
+                return;
+            }
+            prompt_hidden.resize((size_t) n_prompt_tokens * n_embd);
+            int32_t ret;
+            {
+                std::lock_guard<std::mutex> lock(ctx_server.phx_mutex);
+                ret = llama_phx_encode(ctx_server.ctx, tokens.data(), n_prompt_tokens, prompt_hidden.data());
+            }
+            if (ret != 0) {
+                res_error(res, format_error_response("llama_phx_encode failed", ERROR_TYPE_SERVER));
+                return;
+            }
+        } else if (body.contains("content")) {
+            const bool add_special = json_value(body, "add_special", true);
+            const llama_tokens tokens = tokenize_mixed(ctx_server.vocab, body.at("content"), add_special, true);
+            n_prompt_tokens = (int32_t) tokens.size();
+            if (n_prompt_tokens == 0) {
+                res_error(res, format_error_response("no tokens to encode", ERROR_TYPE_INVALID_REQUEST));
+                return;
+            }
+            prompt_hidden.resize((size_t) n_prompt_tokens * n_embd);
+            int32_t ret;
+            {
+                std::lock_guard<std::mutex> lock(ctx_server.phx_mutex);
+                ret = llama_phx_encode(ctx_server.ctx, tokens.data(), n_prompt_tokens, prompt_hidden.data());
+            }
+            if (ret != 0) {
+                res_error(res, format_error_response("llama_phx_encode failed", ERROR_TYPE_SERVER));
+                return;
+            }
+        } else {
+            res_error(res, format_error_response("\"hidden\", \"tokens\" or \"content\" must be provided", ERROR_TYPE_INVALID_REQUEST));
+            return;
+        }
+
+        /* PHOENIX_PHX_PACK_JACOBI
+           pack_prompt blends earlier hidden rows toward their group mean
+           (group_n / ngram_merge) and leaves the last ngram_protect_last
+           rows raw so the causal tip stays put. parallel_mode=jacobi with
+           n_parallel>1 samples the window head at the request temperature
+           and self-drafts the rest by argmax. speculative=1 compares an
+           in-process argmax draft to the temperature sample (accept when
+           they match, reject when they differ) and counts those drafts.
+           Empty draftModel does not start a second server and does not
+           call /health. Immediate repeats are not drafted. */
+        const bool pack_prompt = json_value(body, "pack_prompt", false);
+        int group_n = 1;
+        if (body.contains("group_n")) group_n = json_value(body, "group_n", 1);
+        else if (body.contains("ngram_merge")) group_n = json_value(body, "ngram_merge", 1);
+        if (group_n < 1) group_n = 1;
+        if (group_n > 3) group_n = 3;
+        int protect_last = json_value(body, "ngram_protect_last", 16);
+        if (protect_last < 1) protect_last = 1;
+        int n_parallel = json_value(body, "n_parallel", 1);
+        if (n_parallel < 1) n_parallel = 1;
+        if (n_parallel > 8) n_parallel = 8;
+        std::string parallel_mode;
+        if (body.contains("parallel_mode") && body.at("parallel_mode").is_string())
+            parallel_mode = body.at("parallel_mode").get<std::string>();
+        const bool speculative = json_value(body, "speculative", false) || parallel_mode == "speculative";
+        const bool jacobi = n_parallel > 1 &&
+            (parallel_mode == "jacobi" || parallel_mode == "speculative" || speculative);
+        const float pack_alpha = pack_prompt ? 0.15f : 0.f;
+        int packed_groups = 0;
+        float pack_l2 = 0.f;
+        if (pack_prompt && group_n >= 2 && n_prompt_tokens > protect_last) {
+            const int head = n_prompt_tokens - protect_last;
+            std::vector<float> saved_row(n_embd);
+            bool saved = false;
+            for (int i = 0; i + group_n <= head; i += group_n) {
+                std::vector<float> mean(n_embd, 0.f);
+                for (int k = 0; k < group_n; ++k) {
+                    const float * row = prompt_hidden.data() + (size_t)(i + k) * n_embd;
+                    for (int d = 0; d < n_embd; ++d) mean[d] += row[d];
+                }
+                const float inv = 1.f / (float) group_n;
+                for (float & v : mean) v *= inv;
+                for (int k = 0; k < group_n; ++k) {
+                    float * row = prompt_hidden.data() + (size_t)(i + k) * n_embd;
+                    if (!saved && k == 0) {
+                        std::copy(row, row + n_embd, saved_row.begin());
+                        saved = true;
+                    }
+                    for (int d = 0; d < n_embd; ++d)
+                        row[d] = (1.f - pack_alpha) * row[d] + pack_alpha * mean[d];
+                }
+                packed_groups++;
+            }
+            if (saved) {
+                const float * row = prompt_hidden.data();
+                double acc = 0.0;
+                for (int d = 0; d < n_embd; ++d) {
+                    const double diff = (double) row[d] - (double) saved_row[d];
+                    acc += diff * diff;
+                }
+                pack_l2 = (float) std::sqrt(acc);
+            }
+        }
+
+        // --- prime KV cache with prompt (fresh cache every request) ---
+        std::vector<llama_pos> prompt_positions(n_prompt_tokens);
+        for (int32_t i = 0; i < n_prompt_tokens; i++) {
+            prompt_positions[i] = i;
+        }
+
+        std::vector<float> prompt_out((size_t) n_prompt_tokens * n_embd);
+        int32_t ret;
+        {
+            std::lock_guard<std::mutex> lock(ctx_server.phx_mutex);
+            llama_kv_cache_clear(ctx_server.ctx);
+            ret = llama_phx_infer(ctx_server.ctx, prompt_hidden.data(), n_prompt_tokens, prompt_positions.data(), prompt_out.data());
+        }
+        if (ret != 0) {
+            res_error(res, format_error_response("llama_phx_infer (prompt) failed", ERROR_TYPE_SERVER));
+            return;
+        }
+
+        // --- sampling setup ---
+        std::mt19937 rng(seed != 0 ? (unsigned) seed : std::random_device{}());
+
+        auto sample_logit = [&rng](const float * logits, int32_t n_vocab, float temp, float p_top) -> llama_token {
+            if (n_vocab <= 0) return -1;
+
+            // Greedy (temperature == 0) -> argmax over the raw logits.
+            if (temp <= 1e-6f) {
+                llama_token best = 0;
+                for (int32_t i = 1; i < n_vocab; ++i) {
+                    if (logits[i] > logits[best]) best = i;
+                }
+                return best;
+            }
+
+            // Apply temperature and softmax.
+            float max_logit = *std::max_element(logits, logits + n_vocab);
+            std::vector<std::pair<double, llama_token>> probs;
+            probs.reserve(n_vocab);
+            double sum = 0.0;
+            for (llama_token i = 0; i < n_vocab; ++i) {
+                double p = std::exp(((double) logits[i] - (double) max_logit) / (double) temp);
+                if (!std::isfinite(p)) p = 0.0;
+                sum += p;
+                probs.emplace_back(p, i);
+            }
+            if (sum <= 0.0 || !std::isfinite(sum)) {
+                llama_token best = 0;
+                for (int32_t i = 1; i < n_vocab; ++i) {
+                    if (logits[i] > logits[best]) best = i;
+                }
+                return best;
+            }
+            for (auto & pr : probs) pr.first /= sum;
+
+            // Top-p (nucleus) filtering.
+            float clamped_top_p = std::clamp(p_top, 0.0f, 1.0f);
+            if (clamped_top_p <= 0.0f) clamped_top_p = 1.0f;
+            std::sort(probs.begin(), probs.end(),
+                      [](const auto & a, const auto & b) { return a.first > b.first; });
+            double cum = 0.0;
+            size_t keep = probs.size();
+            for (size_t i = 0; i < probs.size(); ++i) {
+                cum += probs[i].first;
+                if (cum >= clamped_top_p) {
+                    keep = i + 1;
+                    break;
+                }
+            }
+            probs.resize(keep);
+
+            // Renormalize and sample.
+            double psum = 0.0;
+            for (const auto & pr : probs) psum += pr.first;
+            if (psum > 0.0) {
+                for (auto & pr : probs) pr.first /= psum;
+            }
+            std::uniform_real_distribution<double> dist(0.0, 1.0);
+            double r = dist(rng);
+            cum = 0.0;
+            for (const auto & pr : probs) {
+                cum += pr.first;
+                if (r <= cum) return pr.second;
+            }
+            return probs.back().second;
+        };
+
+        std::vector<llama_token> generated_tokens;
+        std::vector<std::vector<float>> generated_hidden;
+        generated_tokens.reserve(max_tokens);
+        if (return_hidden) {
+            generated_hidden.reserve(max_tokens);
+        }
+
+        std::vector<float> last_hidden(n_embd);
+        std::copy(prompt_out.begin() + (size_t)(n_prompt_tokens - 1) * n_embd,
+                  prompt_out.begin() + (size_t) n_prompt_tokens * n_embd,
+                  last_hidden.begin());
+
+        std::vector<float> logits((size_t) n_vocab);
+        std::vector<float> embd(n_embd);
+        std::vector<float> infer_out(n_embd);
+        std::vector<llama_pos> gen_pos(1);
+
+        int jacobi_accepted = 0;
+        int jacobi_rounds = 0;
+        int jacobi_rejected = 0;
+        int speculative_draft = 0;
+        int speculative_accepted = 0;
+        int speculative_rejected = 0;
+        std::vector<llama_token> prompt_token_ids;
+        if (body.contains("content") && body.at("content").is_string()) {
+            const bool add_special = json_value(body, "add_special", true);
+            prompt_token_ids = tokenize_mixed(ctx_server.vocab, body.at("content").get<std::string>(), add_special, true);
+        } else if (body.contains("tokens") && body.at("tokens").is_array()) {
+            prompt_token_ids = body.at("tokens").get<llama_tokens>();
+        }
+        {
+            const llama_token bos = llama_vocab_bos(ctx_server.vocab);
+            if (bos >= 0 && !prompt_token_ids.empty() && prompt_token_ids.front() == bos)
+                prompt_token_ids.erase(prompt_token_ids.begin());
+        }
+        auto is_stop = [&](llama_token tok) {
+            return std::find(stop_token_ids.begin(), stop_token_ids.end(), tok) != stop_token_ids.end();
+        };
+        /* Jacobi still drafts, but a suffix that replays the prompt prefix
+           after an answer token is not committed. That keeps the window
+           from echoing the user sentence. */
