{
  "name": "camera_probe_prepare_only",
  "gerberRoot": "tools/stimulation_gerber_example",
  "layers": {
    "top": "camera_top.gtl"
  },
  "componentNetlists": [
    "catastrophe/eext_netlist_9.json"
  ],
  "anchors": [
    {
      "net": "CAM_3V3",
      "layer": "top",
      "x_mm": 10.0,
      "y_mm": 10.0,
      "tolerance_mm": 0.4
    },
    {
      "net": "CAM_RESET_N",
      "layer": "top",
      "x_mm": 20.0,
      "y_mm": 10.0,
      "tolerance_mm": 0.4
    },
    {
      "net": "GPIO13_EXT_PWM1",
      "layer": "top",
      "x_mm": 30.0,
      "y_mm": 10.0,
      "tolerance_mm": 0.4
    }
  ],
  "probes": [
    {
      "name": "probe_cam_3v3",
      "layer": "top",
      "x_mm": 12.0,
      "y_mm": 10.0,
      "tolerance_mm": 0.4,
      "expected_net": "CAM_3V3"
    },
    {
      "name": "probe_cam_reset",
      "layer": "top",
      "x_mm": 22.0,
      "y_mm": 10.0,
      "tolerance_mm": 0.4,
      "expected_net": "CAM_RESET_N"
    },
    {
      "name": "probe_pwm_drive",
      "layer": "top",
      "x_mm": 32.0,
      "y_mm": 10.0,
      "tolerance_mm": 0.4,
      "expected_net": "GPIO13_EXT_PWM1"
    }
  ],
  "sources": [
    {
      "name": "VCC",
      "kind": "voltage",
      "positive": "CAM_3V3",
      "negative": "GND",
      "waveform": {
        "kind": "dc",
        "value": 3.3
      }
    },
    {
      "name": "DRV",
      "kind": "voltage",
      "positive": "GPIO13_EXT_PWM1",
      "negative": "GND",
      "waveform": {
        "kind": "step",
        "v1": 0.0,
        "v2": 3.3,
        "t_step": 0.00005
      }
    }
  ],
  "analyses": [
    {
      "type": "op",
      "observe": [
        "probe:probe_cam_3v3",
        "probe:probe_cam_reset",
        "probe:probe_pwm_drive",
        "I(VCC)",
        "I(DRV)"
      ]
    },
    {
      "type": "tran",
      "step": 0.00001,
      "stop": 0.0002,
      "observe": [
        "probe:probe_cam_reset",
        "probe:probe_pwm_drive"
      ]
    }
  ],
  "ngspice": {
    "ini": "catastrophe/outsides/ngspice_start/DuSpiceStart.ini"
  },
  "prepareOnly": true
}